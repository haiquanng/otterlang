DATABASE_URL=
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SIGNUP_ENABLED=false
CORS_ORIGINS=http://localhost:5173
# Local http dev: secure false, path /auth. Production (through Vercel's /api proxy):
# secure true, path /api/auth. See .claude/docs/deployment.md.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/auth
# Daily reminders (Web Push). Generate keys with: python -m scripts.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared with the cron-job.org job that calls POST /push/run hourly.
REMINDER_SECRET=
AI_ENABLED=false
GEMINI_API_KEY=
# Optional: defaults to gemini-3.5-flash-lite and 30 new sentences per learner per day.
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_DAILY_LIMIT=30
